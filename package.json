{
  "name": "@5h3d/tables",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts && tailwindcss --input src/styles/library.css --output dist/tables.css --minify && node -e \"require('node:fs').writeFileSync('dist/styles.css.d.ts', 'export {}\\n')\"",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "description": "Mobile-responsive data table for React, with client-side and server-side data handling",
  "packageManager": "pnpm@12.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/5h3d/tables"
  },
  "homepage": "https://5h3d.github.io/tables",
  "keywords": [
    "react",
    "table",
    "data-table",
    "data-grid",
    "responsive",
    "mobile",
    "tanstack-table",
    "typescript",
    "tailwindcss"
  ],
  "author": "Shedrack Udeh",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/tables.css"
    },
    "./source": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.20.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
