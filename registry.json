          "page": "#eef0f4",
          "selection": "#f8f7fe",
          "selection-strong": "#f3f1fc",
          "row-hover": "#f5f6f9",
          "zebra": "#fafbfc",
          "avatar": "#eceaf9",
          "success": "#15653f",
          "success-bg": "#e4f5eb",
          "success-dot": "#1f9d5c",
          "warning": "#7a4f00",
          "warning-bg": "#fbf0d5",
          "warning-dot": "#d99a1e",
